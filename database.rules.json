{
  "rules": {
    "games": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('hostId').val() === auth.uid || (!data.exists() && newData.child('hostId').val() === auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.child('score').val() === 0 && root.child('games').child($pin).exists()) || (data.exists() && !newData.exists()))",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            }
          }
        },
        "answers": {
          "$idx": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('games').child($pin).child('status').val() === 'question'"
            }
          }
        }
      }
    },
    "secret": {
      "$pin": {
        ".read": "auth != null && data.child('hostId').val() === auth.uid",
        ".write": "auth != null && (data.child('hostId').val() === auth.uid || (!data.exists() && newData.child('hostId').val() === auth.uid))"
      }
    }
  }
}
